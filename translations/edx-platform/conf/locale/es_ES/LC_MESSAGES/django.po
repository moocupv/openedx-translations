"{strong_end}"

#: cms/templates/index.html:118
msgid ""
"The term in which your course will run. {strong_start}Note: This is part of "
"your course URL, so no spaces or special characters are allowed and it "
"cannot be changed.{strong_end}"
msgstr ""
"El plazo en el que se desarrollará su curso. {strong_start} Nota: Esto es "
"parte de la URL de su curso, por lo que no se permiten espacios ni "
"caracteres especiales y no se puede cambiar. {strong_end}"

