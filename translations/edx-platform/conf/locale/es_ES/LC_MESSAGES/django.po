msgstr "Debes esperar al menos {wait} segundos entre envíos."

#: xmodule/capa_block.py:1804
#, python-brace-format
msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"Debe esperar al menos {wait_secs} entre envíos. {remaining_secs} restante."

#: xmodule/capa_block.py:1987
#, python-brace-format
msgid "{num_hour} hour"
msgid_plural "{num_hour} hours"
